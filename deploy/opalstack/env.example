# Copy to ~/apps/familydashboard/.env on the server and fill in.

# The port Opalstack assigned to this app (Applications page in the control panel).
PORT=CHANGE_ME

# Generate with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME
FAMILY_TZ=America/New_York

# Opalstack's nginx terminates HTTPS and forwards to 127.0.0.1:$PORT.
BEHIND_PROXY=true
SECURE_COOKIES=true

# Logs next to Opalstack's other app logs. Replace USER with your shell user.
LOG_DIR=/home/USER/logs/apps/familydashboard
LOG_LEVEL=INFO
# Set to true to log every request.
ACCESS_LOG=false
