#!/bin/bash
# Stop the dashboard's gunicorn (only this app's process, via its pidfile).
source "$(dirname "${BASH_SOURCE[0]}")/common.sh"

if ! is_running; then
    echo "Not running."
    rm -f "$PIDFILE"
    exit 0
fi
pid="$(cat "$PIDFILE")"
kill -TERM "$pid"
for _ in $(seq 30); do
    if ! kill -0 "$pid" 2>/dev/null; then
        rm -f "$PIDFILE"
        echo "Stopped."
        exit 0
    fi
    sleep 0.5
done
echo "gunicorn (pid $pid) didn't exit after 15 s; sending KILL." >&2
kill -KILL "$pid" 2>/dev/null || true
rm -f "$PIDFILE"
