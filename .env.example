# Copy to .env and adjust. Loaded automatically by `flask` when python-dotenv is installed.
SECRET_KEY=change-me-to-a-long-random-string
FAMILY_TZ=America/New_York
# Optional; defaults to instance/familydashboard.sqlite3
# DATABASE_URL=sqlite:////absolute/path/to/familydashboard.sqlite3
# Logging (loguru). LOG_FILE is optional and rotates at 10 MB.
LOG_LEVEL=INFO
# LOG_FILE=/var/log/familydashboard/app.log
